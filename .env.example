# Copy to .env and adjust as needed. docker-compose and the app both read these.
POSTGRES_DB=extension_blocker
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# 5433 on the host to avoid clashing with other local Postgres instances on 5432.
POSTGRES_PORT=5433

# Spring datasource (defaults target the docker-compose DB above)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/extension_blocker
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app
